{
  "expo": {
    "name": "",
    "slug": "shumouliya",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shumouliya.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3B3470"
      },
      "package": "com.shumouliya.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "نحتاج الكاميرا لاستخدام ترجمة لغة الإشارة"
        }
      ]
    ]
  }
}